# Rust
/target/

# Linux core dumps. The release profile is `panic = "abort"`, so a crashing
# server or fuzz binary drops a 100MB+ `core` in whatever directory it ran from.
# Anchored to the repo root: `apps/web/src/core/` is real source.
/core
/core.[0-9]*

# Generated by `npm run build:wasm` from crates/ai-studio-wasm.
# Not committed: it would be a 1.4MB binary that goes stale the moment the core
# changes, and the build reproduces it in seconds.
/apps/web/src/core/pkg/

# Generated by tauri-build.
/crates/ai-studio-app/gen/

# Node
node_modules/

# Build output
/apps/web/dist/
*.log

# User documents. Ignored here because this is the app's repo, not a document
# repo — but the whole point of the format is that a workspace *is* worth
# versioning, so keep yours in its own repo and `git diff` will read cleanly.
workspace/

.DS_Store
.env
.env.*
