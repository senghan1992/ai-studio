{
  "name": "ai-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI-readable office suite — Deck, Doc, Grid stored as markdown + JSON pairs",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @ai-studio/server",
    "dev:web": "npm run dev -w @ai-studio/web",
    "build": "npm run build -w @ai-studio/web",
    "start": "npm run start -w @ai-studio/server",
    "test": "node --test packages/format/test packages/formula/test apps/web/test",
    "seed": "node scripts/seed.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
