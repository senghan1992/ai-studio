{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Studio",
  "version": "0.2.0",
  "identifier": "dev.aistudio.desktop",
  "build": {
    "frontendDist": "../../apps/web/dist",
    "devUrl": "http://localhost:5178",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "AI Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' aistudio: http://aistudio.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "AI Studio",
    "category": "Productivity",
    "shortDescription": "AI가 읽을 수 있게 저장하는 오피스 스위트",
    "longDescription": "Office처럼 쓰고, 내용은 Markdown에 배치·계산은 JSON에 나누어 저장합니다. 저장할 때마다 RAG용 AI.md 다이제스트를 함께 생성합니다."
  }
}
